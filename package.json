{
  "name": "finforge-2027",
  "version": "0.1.0",
  "private": true,
  "description": "Official website for FinForge 2027, a hackathon by FinFoundry.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "@upstash/ratelimit": "2.2.3",
    "@upstash/redis": "1.41.1",
    "motion": "14.13.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
