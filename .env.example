# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* values are sent to the browser; everything else stays on the server.

# --- Supabase (server only) ---
# Project URL, e.g. https://<ref>.supabase.co (production: FinForge_2027, tests: FinForge_2027_staging)
SUPABASE_URL=
# Secret key (sb_secret_...) from Supabase dashboard > Project Settings > API Keys. Server only.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...) from the same page. Public by design, but only the
# organizer console's server code uses it (sign-in and RLS-checked reads), so no NEXT_PUBLIC_.
SUPABASE_PUBLISHABLE_KEY=

# --- Cloudflare Turnstile (bot check on the registration form) ---
# Public site key of the FinForge widget (safe to expose). Outside production builds the form
# falls back to Cloudflare's always-pass test key 1x00000000000000000000AA when this is empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key of the same widget. Tests use Cloudflare's always-pass test secret
# 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames a token may come from, e.g. finforge2027.vercel.app. When set, the server
# also requires the "register" action. Leave empty locally (Cloudflare's test keys don't set them).
TURNSTILE_HOSTNAMES=

# --- Upstash Redis (rate limiting, required in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Razorpay (registration fee, server only) ---
# Key ID (rzp_test_... or rzp_live_...) from Razorpay dashboard > Account & Settings > API Keys.
# The key ID is sent to the browser for the checkout pop-up; the secret never is.
RAZORPAY_KEY_ID=
# Key secret from the same page. Server only. Signs and checks the checkout result.
RAZORPAY_KEY_SECRET=
# Secret you type when creating the webhook (Account & Settings > Webhooks, URL
# https://<site>/api/payments/webhook, events payment.captured and order.paid). Server only.
RAZORPAY_WEBHOOK_SECRET=

# --- Sentry (error alerts) ---
# DSN of the finforge-2027 project in Sentry. Public by design (it can only send events). Sentry
# only runs when VERCEL_ENV is "production", so set this for the Production environment only.
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload at build time (optional). Org and project slugs, plus an org auth token
# (Sentry > Settings > Auth Tokens), added as a Sensitive variable. Without the token the build
# skips the upload and stack traces from the browser stay minified.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Testing only ---
# Overrides the registration state from src/config/event.ts ("coming-soon" | "open" | "closed").
# Leave unset in production.
NEXT_PUBLIC_REGISTRATION_STATE=
# Lets a local production build (e2e tests) rate limit in memory without Upstash. Never set on Vercel.
FINFORGE_ALLOW_MEMORY_RATE_LIMIT=
# Points the server's Razorpay calls at a local stand-in (e2e tests only). Never set on Vercel.
RAZORPAY_API_BASE=
# Load tests only: a random secret (32+ characters) set as a branch-scoped PREVIEW variable on the
# load-test branch. Requests carrying it are rate limited per k6 virtual user instead of per IP.
# Ignored outside Vercel previews. Never set on production. See docs/load-testing.md.
FINFORGE_LOAD_TEST_SECRET=
