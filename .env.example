# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* values are sent to the browser; everything else stays on the server.

# --- Supabase (server only) ---
# Project URL, e.g. https://<ref>.supabase.co (production: FinForge_2027, tests: FinForge_2027_staging)
SUPABASE_URL=
# Secret key (sb_secret_...) from Supabase dashboard > Project Settings > API Keys. Server only.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...) from the same page. Public by design, but only the
# organizer console's server code uses it (sign-in and RLS-checked reads), so no NEXT_PUBLIC_.
SUPABASE_PUBLISHABLE_KEY=

# --- Cloudflare Turnstile (bot check on the registration form) ---
# Public site key of the FinForge widget (safe to expose). Outside production builds the form
# falls back to Cloudflare's always-pass test key 1x00000000000000000000AA when this is empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key of the same widget. Tests use Cloudflare's always-pass test secret
# 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (rate limiting, required in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Testing only ---
# Overrides the registration state from src/config/event.ts ("coming-soon" | "open" | "closed").
# Leave unset in production.
NEXT_PUBLIC_REGISTRATION_STATE=
# Lets a local production build (e2e tests) rate limit in memory without Upstash. Never set on Vercel.
FINFORGE_ALLOW_MEMORY_RATE_LIMIT=
